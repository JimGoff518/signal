# SIGNAL — environment configuration
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to git.

# ─── Database ───────────────────────────────────────────────────────────
# Postgres connection string.
# Local dev (matches docker-compose.yml): postgresql+psycopg://signal:signal@localhost:5432/signal
# Production (Supabase): paste the pooled connection string from Project Settings → Database.
# The "+psycopg" suffix is required so SQLAlchemy uses psycopg v3 (not v2). If you
# paste a vanilla "postgresql://..." URL, db.py rewrites it transparently.
DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5432/signal

# ─── Anthropic / Claude (viability memos) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=re_...
ALERT_FROM_EMAIL=signal@gofflawpllc.com
ALERT_TO_EMAIL=jim@gofflawpllc.com

# ─── NHTSA ──────────────────────────────────────────────────────────────
# No key needed; NHTSA's public API is unauthenticated.
# Override the daily ingestion lookback window (days) if needed.
NHTSA_LOOKBACK_DAYS=7

# ─── Dashboard auth ─────────────────────────────────────────────────────
# Multi-user: JSON dict of {username: password}. Takes precedence over the
# single-user fallback below when set.
SIGNAL_USERS={"jim":"change-me","jack":"change-me-too"}
# Single-user fallback (used only if SIGNAL_USERS is empty/missing).
SIGNAL_USERNAME=jim
SIGNAL_PASSWORD=change-me-before-deploy

# ─── App config ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
